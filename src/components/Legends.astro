---
import type { Lang } from '../i18n/utils';
import { legends } from '../i18n/translations';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (s: any) => (typeof s === 'string' ? s : (s[lang] || s.pt || ''));
---
<section id="legends" class="max-w-7xl mx-auto px-6 py-24 md:py-32">
  <div class="max-w-3xl">
    <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-emerald)]">{_(legends.sectionNum)}</div>
    <h2 class="font-display text-4xl md:text-6xl mt-4 leading-tight" set:html={_(legends.heading)} />
    <p class="mt-6 text-[color:var(--color-moss)]/80">{_(legends.subtitle)}</p>
  </div>

  <div class="mt-14 grid md:grid-cols-2 gap-5">
    {legends.items.map((item: any) => (
      <article class="rounded-3xl bg-[color:var(--color-mist)] border border-black/5 p-7 md:p-9 flex flex-col">
        <div class="flex items-center justify-between gap-4">
          <span class="text-3xl leading-none" aria-hidden="true">{item.icon}</span>
          <span class="text-[10px] uppercase tracking-[0.2em] px-3 py-1.5 rounded-full bg-white/70 border border-black/10 text-[color:var(--color-moss)]/70">{_(legends.badge)}</span>
        </div>
        <h3 class="font-display text-2xl mt-5">{_(item.title)}</h3>
        <p class="mt-3 text-sm md:text-base leading-relaxed text-[color:var(--color-moss)]">{_(item.body)}</p>
      </article>
    ))}
  </div>
</section>
