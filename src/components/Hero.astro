---
import type { Lang } from '../i18n/utils';
import { hero } from '../i18n/translations';
import { SITE } from '../data/site';
import { imageSet } from '../utils/img';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (s: any) => typeof s === 'string' ? s : (s[lang] || s.pt || '');
const heroBg = 'linear-gradient(180deg, rgba(11,31,26,.15) 0%, rgba(11,31,26,.55) 55%, rgba(11,31,26,.85) 100%), ' + imageSet(SITE.heroImage);
---
<section id="top" class="hero-bg relative min-h-[100vh] flex items-end pt-24" style={`background-image: ${heroBg}`}>
  <div class="rain absolute inset-0"></div>
  <div class="relative max-w-7xl mx-auto px-6 pb-16 w-full text-white">
    <div class="flex items-center gap-3 mb-6">
      <span class="chip text-white/90 text-xs px-3 py-1 rounded-full bg-white/10">Mirante do Arpoador</span>
      <span class="chip text-white/90 text-xs px-3 py-1 rounded-full bg-white/10">Surf Spot</span>
      <span class="chip text-white/90 text-xs px-3 py-1 rounded-full bg-white/10">Pôr do Sol</span>
    </div>
    <p class="font-display font-semibold leading-[0.95] tracking-tight text-5xl md:text-7xl lg:text-8xl max-w-5xl" set:html={_(hero.title)} />
    <p class="mt-6 max-w-2xl text-white/85 text-lg md:text-xl leading-relaxed">{_(hero.subtitle)}</p>
    <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl">
      <div><div class="num-display text-4xl md:text-5xl">4.8</div><div class="text-xs uppercase tracking-widest text-white/70">32,964 {_(hero.statReviews)}</div></div>
      <div><div class="num-display text-4xl md:text-5xl">Free</div><div class="text-xs uppercase tracking-widest text-white/70">{_(hero.statLength)}</div></div>
      <div><div class="num-display text-4xl md:text-5xl">24h</div><div class="text-xs uppercase tracking-widest text-white/70">{_(hero.statFalls)}</div></div>
      <div><div class="num-display text-4xl md:text-5xl">1970s</div><div class="text-xs uppercase tracking-widest text-white/70">{_(hero.statFlow)}</div></div>
    </div>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href={`/${lang}/#sunset`}
        class="rounded-full bg-[color:var(--color-sun)] px-6 py-3 text-sm font-semibold text-[color:var(--color-ink)] transition hover:brightness-110"
      >
        {_(hero.ctaSunset)}
      </a>
      <a
        href={`/${lang}/#transport`}
        class="rounded-full border border-white/35 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
      >
        {_(hero.ctaTransport)}
      </a>
    </div>
  </div>
</section>
