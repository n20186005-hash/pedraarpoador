---
import type { Lang } from '../i18n/utils';
import { facilities } from '../i18n/translations';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (s: any) => (typeof s === 'string' ? s : (s[lang] || s.pt || ''));
---
<section id="facilities" class="max-w-7xl mx-auto px-6 py-24 md:py-32">
  <div class="max-w-3xl">
    <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-emerald)]">08 — {_(facilities.sectionNum)}</div>
    <h2 class="font-display text-4xl md:text-6xl mt-4 leading-tight" set:html={_(facilities.heading)} />
    <p class="mt-6 text-[color:var(--color-moss)]/80">{_(facilities.subtitle)}</p>
  </div>

  <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {facilities.items.map((item: any) => (
      <article class="rounded-3xl bg-white border border-black/5 p-6 md:p-7 card-hover flex flex-col">
        <div class="text-3xl leading-none" aria-hidden="true">{item.icon}</div>
        <h3 class="font-display text-xl md:text-2xl mt-4">{_(item.title)}</h3>
        <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-moss)]">{_(item.body)}</p>
      </article>
    ))}
  </div>

  <p class="mt-8 text-xs leading-relaxed text-[color:var(--color-moss)]/70 max-w-3xl">{_(facilities.neutralNote)}</p>
</section>
