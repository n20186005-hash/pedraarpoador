---
import type { Lang } from '../i18n/utils';
import { LANGUAGES, LANG_LABELS } from '../i18n/utils';
import { nav } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (s: any) => typeof s === 'string' ? s : (s[lang] || s.pt || '');

// 语言切换保留当前页面路径（如 /pt/privacy → /en/privacy）
const rest = Astro.url.pathname.replace(/^\/[^/]+/, '');
const target = (l: string) => `/${l}${rest || '/'}`;
---
<header class="fixed top-0 inset-x-0 z-50 backdrop-blur bg-[rgba(247,243,234,.75)] border-b border-black/5">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={`/${lang}/`} class="flex items-center gap-2">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M3 20c3-6 6-6 9 0 3-6 6-6 9 0" stroke="#1F3B34" stroke-width="2" stroke-linecap="round"/><path d="M4 14c4-9 12-9 16 0" stroke="#2F6B4E" stroke-width="2" stroke-linecap="round"/></svg>
      <span class="font-display font-semibold tracking-tight">Pedra do Arpoador</span>
    </a>
    <nav class="hidden lg:flex items-center gap-6 text-sm text-[color:var(--color-moss)]">
      <a class="link-underline" href={`/${lang}/#about`}>{_(nav.overview)}</a>
      <a class="link-underline" href={`/${lang}/#highlights`}>{_(nav.highlights)}</a>
      <a class="link-underline" href={`/${lang}/#sunset`}>{_(nav.sunset)}</a>
      <a class="link-underline" href={`/${lang}/#practical`}>{_(nav.guide)}</a>
      <a class="link-underline" href={`/${lang}/#weather`}>{_(nav.weather)}</a>
      <a class="link-underline" href={`/${lang}/#tides`}>{_(nav.tides)}</a>
      <a class="link-underline" href={`/${lang}/#location`}>{_(nav.location)}</a>

      <details class="nav-more relative">
        <summary class="link-underline cursor-pointer select-none">{_(nav.more)}</summary>
        <div class="absolute right-0 mt-3 w-44 rounded-2xl bg-white border border-black/10 shadow-xl p-2">
          <a class="nav-more-item" href={`/${lang}/#climate`}>{_(nav.climate)}</a>
          <a class="nav-more-item" href={`/${lang}/#transport`}>{_(nav.transport)}</a>
          <a class="nav-more-item" href={`/${lang}/#facilities`}>{_(nav.facilities)}</a>
          <a class="nav-more-item" href={`/${lang}/#encyclopedia`}>{_(nav.encyclopedia)}</a>
          <a class="nav-more-item" href={`/${lang}/#timeline`}>{_(nav.timeline)}</a>
          <a class="nav-more-item" href={`/${lang}/#ecology`}>{_(nav.ecology)}</a>
          <a class="nav-more-item" href={`/${lang}/#reviews`}>{_(nav.reviews)}</a>
          <a class="nav-more-item" href={`/${lang}/#faq`}>{_(nav.faq)}</a>
          <a class="nav-more-item" href={`/${lang}/#sources`}>{_(nav.sources)}</a>
        </div>
      </details>
    </nav>
    <div class="flex items-center gap-1 text-xs bg-white/60 border border-black/10 rounded-full p-1">
      {LANGUAGES.map((l) => <a href={target(l)} class={`lang-btn px-2.5 py-1 rounded-full ${l === lang ? 'active' : ''}`}>{LANG_LABELS[l]}</a>)}
    </div>
  </div>
</header>
