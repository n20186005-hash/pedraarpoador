---
import type { Lang } from '../i18n/utils';
import { climate } from '../i18n/translations';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (s: any) => (typeof s === 'string' ? s : (s[lang] || s.pt || ''));
---
<section id="climate" class="bg-white py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-3xl">
      <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-emerald)]">05 — {_(climate.sectionNum)}</div>
      <h2 class="font-display text-4xl md:text-6xl mt-4 leading-tight" set:html={_(climate.heading)} />
      <p class="mt-6 text-[color:var(--color-moss)]/80">{_(climate.subtitle)}</p>
    </div>

    <!-- 四季与旅行季 -->
    <h3 class="font-display text-2xl md:text-3xl mt-14">{_(climate.seasonsHeading)}</h3>
    <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {climate.seasons.map((s: any) => (
        <article class="rounded-3xl border border-black/5 bg-[color:var(--color-mist)] p-6 flex flex-col">
          <span class="text-3xl leading-none" aria-hidden="true">{s.icon}</span>
          <div class="mt-4 text-[11px] uppercase tracking-[0.15em] text-[color:var(--color-emerald)]">{_(s.period)}</div>
          <h4 class="font-display text-lg mt-2">{_(s.title)}</h4>
          <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-moss)]">{_(s.body)}</p>
        </article>
      ))}
    </div>

    <!-- 全年行李 -->
    <h3 class="font-display text-2xl md:text-3xl mt-14">{_(climate.packingHeading)}</h3>
    <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {climate.packing.map((p: any) => (
        <article class="rounded-3xl bg-[color:var(--color-mist)] p-6">
          <div class="flex items-center gap-2">
            <span class="text-xl" aria-hidden="true">{p.icon}</span>
            <h4 class="font-display text-lg">{_(p.title)}</h4>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-moss)]">{_(p.body)}</p>
        </article>
      ))}
    </div>

    <p class="mt-10 text-xs text-[color:var(--color-moss)]/60">{_(climate.note)}</p>
  </div>
</section>
